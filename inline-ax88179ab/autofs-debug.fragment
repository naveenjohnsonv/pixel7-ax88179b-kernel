# Pixel 7 Pro: on-demand mounts and ABI-checked optional diagnostics.
# Added function/graph tracers and snapshots alter prebuilt-module interfaces.
# Use existing BPF/kprobe/MMIO and per-file dynamic-debug CORE support instead.
CONFIG_AUTOFS_FS=y
CONFIG_FUNCTION_TRACER=n
CONFIG_DYNAMIC_FTRACE=n
CONFIG_FUNCTION_GRAPH_TRACER=n
CONFIG_DYNAMIC_DEBUG=n
CONFIG_TRACER_SNAPSHOT=n
